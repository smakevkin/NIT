extends ../components/header

block content
  .page.page--cn-hohol
    .page__container
      h1.page__title Китайская хохлатая собака
      .page__image-container
        img.page__image(src=require("../img/cnHohol.png"))
      .page__content
        p.page__paragraph Китайская хохлатая собака — порода комнатно-декоративных собак.
        p.page__paragraph Собака маленькая, активная, изящная, очень жизнерадостная.
        p.page__paragraph Собаки этой породы могут быть как голыми (волосы имеются только в области головы, хвоста и на конечностях), так и с мягкими вуалеобразными волосами, покрывающими всё тело — пуховки (паудер пуфф).