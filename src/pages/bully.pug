extends ../components/header

block content
  .page.page--bully
    .page__container
      h1.page__title Американский булли
      .page__image-container
        img.page__image(src=require("../img/bully.png"))
      .page__content
        p.page__paragraph Америка́нский бу́лли (англ. American Bully) — селектированная в США порода собак-компаньонов.
        p.page__paragraph Порода получила признание Объединённым клубом собаководов 15 июля 2013 года.
        p.page__paragraph Порода была впервые зарегистрирована Американским Булли клубом собаководов (ABKC) в 2004 году.
        p.page__paragraph Особенностью породы является наличие нескольких фенотипов, различающихся ростом.
        p.page__paragraph Таким образом, Американский Булли одновременно классифицируется как мелкая и как крупная порода, которая впоследствии была разделена на четыре категории; Карманные, Стандартные, Классические и XL.